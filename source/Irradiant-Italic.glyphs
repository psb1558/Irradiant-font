             AEacute AEmacron B D Dcaron Dcroat E Eth Eacute Ebreve Ecaron Ecircumflex Edieresis
             Edotaccent Egrave Emacron Eogonek Etilde  F H I I IJ Iacute Ibreve Icircumflex
             Idieresis Igrave Imacron Iogonek Itilde  K L Lacute Lcaron Lcommaaccent Lslash M N
             Nacute Ncaron Ncommaaccent Ntilde P Thorn R Racute Rcaron Rcommaaccent Z Zacute Zcaron
             Zdotaccent a.sc a.sc aacute.sc abreve.sc acaron.sc acircumflex.sc adieresis.sc agrave.sc
             amacron.sc aogonek.sc aring.sc atilde.sc ae.sc aeacute.sc aemacron.sc b.sc d.sc
             dcaron.sc dcroat.sc e.sc eth.sc eacute.sc ebreve.sc ecaron.sc ecircumflex.sc edieresis.sc
             edotaccent.sc egrave.sc emacron.sc eogonek.sc etilde.sc  f.sc h.sc i.sc iacute.sc
             ibreve.sc icircumflex.sc idieresis.sc igrave.sc imacron.sc iogonek.sc itilde.sc ij.sc 
             k.sc l.sc lacute.sc lcaron.sc lcommaaccent.sc lslash.sc m.sc n.sc nacute.sc ncaron.sc
             ncommaaccent.sc ntilde.sc p.sc thorn.sc r.sc racute.sc rcaron.sc rcommaaccent.sc 
             z.sc zacute.sc zcaron.sc zdotaccent.sc ] ;

@Before_p = [ @Lowercase B D Dcaron Eth Dcroat O Oacute Obreve Ocircumflex Odieresis Ograve Ohungarumlaut
              Omacron Oogonek Oslash Otilde P S Sacute Scaron Scedilla Thorn ] ;

lookup shorterRLeg {
  sub [ R     Rcaron     Racute     Rcommaaccent     r.sc     rcaron.sc     racute.sc     rcommaaccent.sc     ]' @RightOfR by
      [ R.alt Rcaron.alt Racute.alt Rcommaaccent.alt r.alt.sc rcaron.alt.sc racute.alt.sc rcommaaccent.alt.sc ] ;
#  sub [ R     Rcaron     Racute     Rcommaaccent     ]' @RightOfR by
#      [ R.alt Rcaron.alt Racute.alt Rcommaaccent.alt ] ;
} shorterRLeg ;

lookup non_colliding_y {
  sub [ g j q z zacute zcaron zdotaccent ] [ y yacute ycircumflex ydieresis ygrave ymacron ytilde ]' by
      [ y.alt yacute.alt ycircumflex.alt ydieresis.alt ygrave.alt ymacron.alt ytilde.alt ] ;
} non_colliding_y ;

lookup non_colliding_t {
    sub t' [f f_f f_i f_l f_t f_f_i f_f_l ] by t.rf ;
} non_colliding_t ;

lookup non_colliding_z {
  sub [z zacute zcaron zdotaccent ]' [f g j p y.alt longs] by [z.alt zacute.alt zcaron.alt zdotaccent.alt ] ;
} non_colliding_z ;

lookup double_g {
  sub [ g gcommaaccent gdotaccent ]' lookup left_double_g [ g gcommaaccent gdotaccent ]' lookup right_double_g ;
} double_g ;

lookup wordFinalLetters {
  ignore sub [Q q.sc]' @AllLetters ;
  sub [Q q.sc]' by [Q.alt q.alt.sc] ;
#  ignore sub [ f f_f Q ]' @AllLetters ;
#  sub [ f f_f Q ]' by [ f.alt f_f.alt Q.alt ] ;
} wordFinalLetters ;

lookup contextualQ {
  sub Q' @Lowercase [ g gcommaaccent gdotaccent j jdotless jacute p thorn y yacute ybreve ycircumflex ydieresis ygrave ymacron ytilde ] by Q.alt ;
} contextualQ ;


lookup wordInitialLetters {
  ignore sub @Before_p p' ;
  sub p' by p.alt ;
} wordInitialLetters ;

lookup uppercaseSharpS {
	sub @Uppercase @Uppercase germandbls' by germandbls.calt ;
	sub germandbls' @Uppercase by germandbls.calt ;
} uppercaseSharpS;

lookup fBeforeDiacritics {
    sub [f f_f longs longs_longs]' @lcWithTopAccent by [f.alt f_f.alt longs.alt longs_longs.alt] ;
} fBeforeDiacritics ;
