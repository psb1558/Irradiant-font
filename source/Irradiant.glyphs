{
code = "# Lookup 4
lookup ss08_longs_single {
  sub s by longs ;
} ss08_longs_single ;

# Lookup 5
lookup ss08_longs_dflt {
  lookupflag UseMarkFilteringSet @CombiningTopAccents;
  sub @LowerCase_f longs' by s ;
  sub @LowerCase_f @CombiningTopAccents longs' by s ;
  sub longs' zerowidthnonjoiner by s;
  sub longs' @CombiningTopAccents zerowidthnonjoiner by s;
  ignore sub longs' @AllLowerCaseExcept_f ;
  ignore sub longs' @CombiningTopAccents @AllLowerCaseExcept_f ;
  sub longs' by s ;
} ss08_longs_dflt ;

# Lookup 6
lookup ss08_longs_ENG {
  lookupflag UseMarkFilteringSet @CombiningTopAccents;
  sub @LowerCase_f longs' by s ;
  sub @LowerCase_f @CombiningTopAccents longs' by s ;
  sub [A E O a e o] longs longs' [b h k t] by s;
  sub [A E O a e o] @CombiningTopAccents longs longs' [b h k t] by s;
  sub @longs_class_1 longs' longs [b h k t] by s;
  sub @longs_class_1 @CombiningTopAccents longs' longs [b h k t] by s;
  sub longs' [ j zerowidthnonjoiner ] by s;
  sub longs' @CombiningTopAccents [ j zerowidthnonjoiner ] by s;
  ignore sub longs' [ @AllLowerCaseExcept_f ] ;
  ignore sub longs' @CombiningTopAccents [ @AllLowerCaseExcept_f ] ;
  sub longs' by s ;
} ss08_longs_ENG ;

# Lookup 7
lookup ss08_longs_FRA {
  lookupflag UseMarkFilteringSet @CombiningTopAccents;
  sub @LowerCase_f longs' by s;
  sub @LowerCase_f @CombiningTopAccents longs' by s;
  sub longs' zerowidthnonjoiner by s;
  sub longs' @CombiningTopAccents zerowidthnonjoiner by s;
  ignore sub longs' [ @AllLowerCaseExcept_bfh ] ;
  ignore sub longs' @CombiningTopAccents [ @AllLowerCaseExcept_bfh ] ;
  sub longs' by s;
} ss08_longs_FRA ;

# lookup 8
lookup ss08_longs_ITA {
  lookupflag UseMarkFilteringSet @CombiningTopAccents;
  sub @LowerCase_f longs' by s;
  sub @LowerCase_f @CombiningTopAccents longs' by s;
  sub longs' [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
  sub longs' @CombiningTopAccents [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
  ignore sub longs' [ @AllLowerCaseExcept_f ] ;
  ignore sub longs' @CombiningTopAccents [ @AllLowerCaseExcept_f ] ;
  sub longs' by s ;
} ss08_longs_ITA ;

# lookup 9
lookup ss08_longs_ESP {
  lookupflag UseMarkFilteringSet @CombiningTopAccents;
  sub @LowerCase_f longs' by s;
  sub @LowerCase_f @CombiningTopAccents longs' by s;
  sub longs' [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
  sub longs' @CombiningTopAccents [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
  sub longs longs' i by s;
  sub longs longs' @CombiningTopAccents i by s;
  ignore sub longs' [ @AllLowerCaseExcept_f ] ;
  ignore sub longs' @CombiningTopAccents [ @AllLowerCaseExcept_f ] ;
  sub longs' by s ;
} ss08_longs_ESP ;
";
name = MiscLookups;
}
