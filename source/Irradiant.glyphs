{
code = "lookup ccmp_Other_1 {
	lookupflag UseMarkFilteringSet @CombiningTopAccents;
	sub i' @CombiningTopAccents by idotless;
	sub j' @CombiningTopAccents by jdotless;
} ccmp_Other_1;

lookup ccmp_Other_2 {
	lookupflag 0;
	@Markscomb = [dieresiscomb gravecomb acutecomb circumflexcomb caroncomb tildecomb macroncomb];
	@MarkscombCase = [dieresiscomb.case gravecomb.case acutecomb.case circumflexcomb.case caroncomb.case tildecomb.case macroncomb.case];
	sub @Uppercase @Markscomb' by @MarkscombCase;
} ccmp_Other_2;

lookup ccmp_Other_3 {
	lookupflag 0;
	sub @MarkscombCase @Markscomb' by @MarkscombCase;
} ccmp_Other_3;

lookup noCodeComoposites {
  sub ae brevecomb by aebreve ;
  sub AE brevecomb by AEbreve ;
  sub y brevecomb by ybreve ;
  sub Y brevecomb by Ybreve ;
} noCodeComoposites ;

lookup horncomb {
  sub o horncomb by ohorn ;
  sub oacute horncomb by ohornacute ;
  sub odotbelow horncomb by ohorndotbelow ;
  sub ograve horncomb by ohorngrave ;
  sub ohookabove horncomb by ohornhookabove ;
  sub otilde horncomb by ohorntilde ;
  sub u horncomb by uhorn ;
  sub uacute horncomb by uhornacute ;
  sub udotbelow horncomb by uhorndotbelow ;
  sub ugrave horncomb by uhorngrave ;
  sub uhookabove horncomb by uhornhookabove ;
  sub utilde horncomb by uhorntilde ;
  sub O horncomb by Ohorn ;
  sub Oacute horncomb by Ohornacute ;
  sub Odotbelow horncomb by Ohorndotbelow ;
  sub Ograve horncomb by Ohorngrave ;
  sub Ohookabove horncomb by Ohornhookabove ;
  sub Otilde horncomb by Ohorntilde ;
  sub U horncomb by Uhorn ;
  sub Uacute horncomb by Uhornacute ;
  sub Udotbelow horncomb by Uhorndotbelow ;
  sub Ugrave horncomb by Uhorngrave ;
  sub Uhookabove horncomb by Uhornhookabove ;
  sub Utilde horncomb by Uhorntilde ;
} horncomb ;";
tag = ccmp;
