{
code = "@RightOfR = [A Aacute Abreve Acaron Acircumflex Adieresis Agrave Amacron Aogonek Aring Atilde AE
             AEacute AEmacron B D Dcaron Dcroat E Eth Eacute Ebreve Ecaron Ecircumflex Edieresis
             Edotaccent Egrave Emacron Eogonek Etilde  F H I I IJ Iacute Ibreve Icircumflex
             Idieresis Igrave Imacron Iogonek Itilde  K L Lacute Lcaron Lcommaaccent Lslash M N
             Nacute Ncaron Ncommaaccent Ntilde P Thorn R Racute Rcaron Rcommaaccent S Z Zacute Zcaron
             Zdotaccent a.sc a.sc aacute.sc abreve.sc acaron.sc acircumflex.sc adieresis.sc agrave.sc
             amacron.sc aogonek.sc aring.sc atilde.sc ae.sc aeacute.sc aemacron.sc b.sc d.sc
             dcaron.sc dcroat.sc e.sc eth.sc eacute.sc ebreve.sc ecaron.sc ecircumflex.sc edieresis.sc
             edotaccent.sc egrave.sc emacron.sc eogonek.sc etilde.sc  f.sc h.sc i.sc iacute.sc
             ibreve.sc icircumflex.sc idieresis.sc igrave.sc imacron.sc iogonek.sc itilde.sc ij.sc 
             k.sc l.sc lacute.sc lcaron.sc lcommaaccent.sc lslash.sc m.sc n.sc nacute.sc ncaron.sc
             ncommaaccent.sc ntilde.sc p.sc thorn.sc r.sc racute.sc rcaron.sc rcommaaccent.sc s.sc 
             z.sc zacute.sc zcaron.sc zdotaccent.sc ] ;

@LC_with_diacritics = [aacute abreve acaron acircumflex adieresis aebreve agrave amacron aring atilde aeacute aemacron cacute ccaron cdotaccent eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron etilde gcommaaccent gdotaccent i iacute ibreve icircumflex idieresis igrave imacron iogonek itilde idotaccent ij jacute lacute lcaron nacute ncaron ntilde oacute obreve ocircumflex odieresis ograve ohungarumlaut omacron oogonek otilde racute rcaron sacute scaron uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uring utilde wacute wcircumflex wdieresis wgrave yacute ybreve ycircumflex ydieresis ygrave ymacron ytilde zacute zcaron zdotaccent ] ;

lookup nonColliding {
  sub f' @LC_with_diacritics by f.narrow ;
} nonColliding ;

lookup shorterRLeg {
  sub [ R     Rcaron     Racute     Rcommaaccent     r.sc     rcaron.sc     racute.sc     rcommaaccent.sc     ]' @RightOfR by
      [ R.alt Rcaron.alt Racute.alt Rcommaaccent.alt r.alt.sc rcaron.alt.sc racute.alt.sc rcommaaccent.alt.sc ] ;
} shorterRLeg ;

lookup wordFinalQ {
  ignore sub [Q q.sc]' @AllLetters ;
  sub [Q q.sc]' by [Q.alt q.alt.sc] ;
} wordFinalQ ;

lookup contextualQ {
  sub Q' @Lowercase [ g gcommaaccent gdotaccent j jdotless jacute p thorn y yacute ybreve ycircumflex ydieresis ygrave ymacron ytilde ] by Q.alt ;
} contextualQ ;

lookup uppercaseSharpS {
	sub @Uppercase @Uppercase germandbls' by germandbls.calt ;
	sub germandbls' @Uppercase by germandbls.calt ;
} uppercaseSharpS;
";
tag = calt;
},
